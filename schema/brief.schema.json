{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/morning-brief-kit/brief.schema.json",
  "title": "Daily Brief",
  "description": "One morning brief covering the last 24 hours.",
  "type": "object",
  "required": ["schema_version", "type", "date", "vibe", "tldr", "stories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "type": { "const": "daily" },
    "date": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "vibe": { "type": "string", "minLength": 1, "description": "One line on the mood of the day." },
    "tldr": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "stories": {
      "type": "array", "maxItems": 12,
      "items": { "$ref": "#/$defs/story" }
    },
    "move": {
      "type": "object", "required": ["title"], "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      }
    },
    "talking_points": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "quick_hits": {
      "type": "array",
      "items": {
        "type": "object", "required": ["text"], "additionalProperties": false,
        "properties": { "text": { "type": "string", "minLength": 1 }, "url": { "$ref": "#/$defs/url" } }
      }
    },
    "local": { "$ref": "#/$defs/local" },
    "watch_next": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sources_read": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "notes": { "type": "string" }
  },
  "$defs": {
    "url": { "type": "string", "pattern": "^https?://" },
    "source": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "url": { "$ref": "#/$defs/url" } }
    },
    "story": {
      "type": "object",
      "required": ["id", "spark", "summary", "why_it_matters", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "rank": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "spark": { "type": "string", "minLength": 1, "description": "Punchy headline, 12 words or fewer." },
        "summary": { "type": "string", "minLength": 1 },
        "why_it_matters": { "type": "string", "minLength": 1 },
        "pillar": { "type": "string" },
        "angle": { "type": "string", "description": "Opinion or prediction, clearly not fact." },
        "confidence": { "enum": ["confirmed", "reported", "early"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
      }
    },
    "local": {
      "type": "object", "required": ["area", "items"], "additionalProperties": false,
      "properties": {
        "area": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["text"], "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "source": { "type": "string" },
              "url": { "$ref": "#/$defs/url" }
            }
          }
        }
      }
    }
  }
}
