# Copy this file to .env and fill it in. .env is ignored by git.

# anthropic = Claude. openai = any OpenAI-compatible API (OpenAI, Gemini, Grok, Ollama...).
BRIEF_PROVIDER=anthropic

# Your API key. Leave empty for local models (Ollama, LM Studio).
BRIEF_API_KEY=

# The model name from your provider's docs. See docs/models.md.
BRIEF_MODEL=

# Only for non-OpenAI providers on the "openai" setting, for example:
#   Google Gemini   https://generativelanguage.googleapis.com/v1beta/openai
#   xAI Grok        https://api.x.ai/v1
#   OpenRouter      https://openrouter.ai/api/v1
#   Ollama (local)  http://localhost:11434/v1
#   LM Studio       http://localhost:1234/v1
BRIEF_BASE_URL=
